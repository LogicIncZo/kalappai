{
  "name": "kalappai",
  "private": true,
  "version": "0.2.0",
  "description": "Tamil-first, open-source, browser-based typing tutor — Tamil99, InScript, Tamil Typewriter, Phonetic (transliteration). PWA, works offline.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src test scripts demo --error-on-warnings",
    "test": "bun test test/",
    "contract:check": "bun scripts/check-contract.ts",
    "contract:sync": "bash scripts/sync-contract.sh",
    "docs:check": "bun scripts/check-docs.ts",
    "smoke:dist": "bun scripts/smoke-dist.ts",
    "smoke:live": "bun scripts/smoke-live.ts",
    "demo:seed": "bun demo/seed.ts",
    "demo:walkthrough": "bun demo/walkthrough.ts",
    "verify": "bash scripts/verify.sh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@biomejs/biome": "^2.5.14"
  }
}
